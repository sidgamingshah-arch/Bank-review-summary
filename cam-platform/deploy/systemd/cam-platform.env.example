# Production settings for the cam-platform systemd unit.
# Copy to /etc/cam/cam-platform.env, edit, and `chmod 600` (it holds secrets).
# Every value is a CAM_* environment variable read by the services at startup.

# --- security / identity (REQUIRED) ---
CAM_JWT_SECRET=change-me-to-a-long-random-secret

# --- persistence ---
# PostgreSQL is the production system of record; omit CAM_DB_URL to fall back to
# per-service SQLite files under CAM_DATA_DIR (fine for a small single host).
CAM_DB_URL=postgresql+psycopg://cam:cam@localhost:5432/cam
CAM_DATA_DIR=/var/lib/cam

# --- model provider ---
# mock (offline) | anthropic | openai (OpenAI-compatible) | azure
CAM_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OpenAI-compatible endpoint (CAM_LLM_PROVIDER=openai):
# CAM_GENAI_BASE_URL=https://llm.internal/v1
# CAM_GENAI_MODEL=your-model
# CAM_GENAI_API_KEY=

# --- run queue / concurrency ---
CAM_WORKER_POOL_SIZE=8
CAM_MAX_CONCURRENT_RUNS=4
# give a cold start extra headroom before the supervisor gives up
CAM_STACK_HEALTH_TIMEOUT=120

# --- email notifications (optional; empty host => logged, not sent) ---
CAM_SMTP_HOST=
CAM_SMTP_PORT=587
CAM_SMTP_USERNAME=
CAM_SMTP_PASSWORD_ENV=CAM_SMTP_PASSWORD
CAM_SMTP_PASSWORD=
CAM_SMTP_FROM=CAM Studio <cam-studio@bank.example>
CAM_APP_BASE_URL=https://cam.internal

# --- external connectors (optional; empty URL => labelled mock) ---
# CAM_CONNECTOR_NEWS_URL=
# CAM_CONNECTOR_SEARCH_URL=
# CAM_CONNECTOR_API_KEY_ENV=CAM_CONNECTOR_API_KEY
# CAM_CONNECTOR_API_KEY=

# --- Opik prompt store for section prompts (optional) ---
# The normal DB is the store until an Opik path/credentials are provided here.
# Provide a URL (self-hosted, prefer TLS) and/or an API key (Comet cloud).
# CAM_OPIK_URL=https://opik.internal/api
# CAM_OPIK_WORKSPACE=
# CAM_OPIK_PROJECT=cam-prompts
# CAM_OPIK_API_KEY_ENV=OPIK_API_KEY
# OPIK_API_KEY=
# CAM_OPIK_ENABLED=false                    # optional kill switch (force normal DB)

# --- serve the built SPA from the gateway (single origin) ---
# defaults to <repo>/frontend/dist; set explicitly if you build elsewhere
# CAM_FRONTEND_DIST=/opt/cam/cam-platform/frontend/dist
